generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "vault"]
}

// ── ENUMS ──────────────────────────────────────────────
enum UserTipo {
  PAI
  ALUNO
  ACADEMIA
  ADMIN
  @@schema("public")
}

enum SeloNivel {
  NENHUM
  BRONZE
  PRATA
  OURO
  @@schema("public")
}

enum CursoTipo {
  PROTECAO_MENORES
  PREVENCAO_ASSEDIO
  INCLUSAO
  OUTRO
  @@schema("public")
}

enum DenunciaTipo {
  ASSEDIO_SEXUAL
  ASSEDIO_MORAL
  VIOLENCIA
  OUTRO
  @@schema("vault")
}

enum DenunciaStatus {
  RECEBIDA
  TRIAGEM
  EM_APURACAO
  ENCERRADA
  @@schema("vault")
}

enum Urgencia {
  BAIXA
  MEDIA
  ALTA
  CRITICA
  @@schema("vault")
}

// ── USUÁRIOS ──────────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  auth_id     String    @unique
  tipo        UserTipo
  nome        String?
  email       String?   @unique
  telefone    String?
  criado_em   DateTime  @default(now())
  academia    Academia?
  avaliacoes  Avaliacao[]

  @@schema("public")
}

// ── ACADEMIAS ─────────────────────────────────────────────
model Academia {
  id              String    @id @default(cuid())
  user_id         String    @unique
  nome            String
  cnpj            String?   @unique
  endereco        Json
  telefone        String?
  instagram       String?
  descricao       String?
  foto_url        String?
  nivel_selo      SeloNivel
  verificada      Boolean   @default(false)
  ativa           Boolean   @default(true)
  criado_em       DateTime  @default(now())
  atualizado_em   DateTime  @updatedAt
  certificados    Certificado[]
  avaliacoes      Avaliacao[]
  user            User      @relation(fields: [user_id], references: [id])

  @@schema("public")
}

// ── CERTIFICADOS DE CURSO ─────────────────────────────────
model Certificado {
  id            String    @id @default(cuid())
  academia_id   String
  tipo          CursoTipo
  instrutor     String
  emitido_em    DateTime  @default(now())
  validade_em   DateTime
  url_pdf       String?
  academia      Academia  @relation(fields: [academia_id], references: [id])

  @@schema("public")
}

// ── AVALIAÇÕES ────────────────────────────────────────────
model Avaliacao {
  id            String    @id @default(cuid())
  academia_id   String
  user_id       String
  nota          Int
  categorias    Json
  comentario    String?
  criado_em     DateTime  @default(now())
  academia      Academia  @relation(fields: [academia_id], references: [id])
  user          User      @relation(fields: [user_id], references: [id])

  @@schema("public")
}

// ── DENÚNCIAS (VAULT) ─────────────────────────────────────
model Denuncia {
  id              String        @id @default(cuid())
  protocolo       String        @unique
  tipo            DenunciaTipo
  descricao_enc   Bytes
  academia_ref    String?
  status          DenunciaStatus @default(RECEBIDA)
  urgencia        Urgencia      @default(MEDIA)
  envolve_menor   Boolean       @default(false)
  evidencias      DenunciaEvidencia[]
  historico       DenunciaHistorico[]
  criado_em       DateTime      @default(now())
  atualizado_em   DateTime      @updatedAt

  @@schema("vault")
}

model DenunciaEvidencia {
  id           String   @id @default(cuid())
  denuncia_id  String
  s3_key       String
  tipo_mime    String
  tamanho_kb   Int
  criado_em    DateTime @default(now())
  denuncia     Denuncia @relation(fields: [denuncia_id], references: [id])

  @@schema("vault")
}

model DenunciaHistorico {
  id           String         @id @default(cuid())
  denuncia_id  String
  status_de    DenunciaStatus
  status_para  DenunciaStatus
  nota_interna String?
  operador_id  String
  criado_em    DateTime       @default(now())
  denuncia     Denuncia       @relation(fields: [denuncia_id], references: [id])

  @@schema("vault")
}
